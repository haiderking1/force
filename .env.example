# Cline Pass / DeepSeek V4.1 Flash. OpenAI-compatible.
# Subscription models use the cline-pass/ prefix with the same Cline Bearer API key.
# https://raw.githubusercontent.com/cline/cline/main/docs/getting-started/clinepass.mdx
# No fallback to free or paid billing. Non-Pass models are rejected for cline-pass.
# For free or paid Cline, replace BOTH provider and model:
# cline-free + cline-free/deepseek-v4.1-flash
# cline + deepseek/deepseek-v4.1-flash
# An empty MODEL uses the selected provider default. All use the same endpoint.
FORCE_TRANSLATION_PROVIDER=cline-pass
FORCE_TRANSLATION_BASE_URL=https://api.cline.bot/api/v1
FORCE_TRANSLATION_MODEL=cline-pass/deepseek-v4.1-flash
FORCE_TRANSLATION_API_KEY=
FORCE_TRANSLATION_TARGET_LANGUAGE=ar
FORCE_TRANSLATION_WORKERS=100
FORCE_TRANSLATION_BATCH_SIZE=50
FORCE_TRANSLATION_MAX_RETRIES=2
FORCE_TRANSLATION_RETRY_BACKOFF_MS=500
FORCE_TRANSLATION_TEMPERATURE=0

# TypeSafe Jev / System One. Separate from FORCE_TRANSLATION_*.
# Official docs: https://docs.typesafe.ai/api
# POST https://api.typesafe.ai/v1/systemone
# Official SDK env name is TYPESAFE_API_KEY. Force uses FORCE_JEV_API_KEY.
# discover scan never reads this. discover classify does.

FORCE_JEV_API_KEY=
FORCE_JEV_BASE_URL=https://api.typesafe.ai
FORCE_JEV_MODEL=jev-latest
FORCE_JEV_MAX_RETRIES=2
FORCE_JEV_RETRY_BACKOFF_MS=500
FORCE_JEV_CONCURRENCY=4
