# Cline Free / DeepSeek V4.1 Flash. OpenAI-compatible.
# HTTP model id is cline-free/deepseek-v4.1-flash.
# The Pi id cline-free/cline-free/deepseek-v4.1-flash is not sent on the wire.
# Auth is a Cline/WorkOS access token. Leave the key empty here.

FORCE_TRANSLATION_PROVIDER=cline-free
FORCE_TRANSLATION_BASE_URL=https://api.cline.bot/api/v1
FORCE_TRANSLATION_MODEL=cline-free/deepseek-v4.1-flash
FORCE_TRANSLATION_API_KEY=
FORCE_TRANSLATION_TARGET_LANGUAGE=ar
FORCE_TRANSLATION_WORKERS=100
FORCE_TRANSLATION_BATCH_SIZE=50
FORCE_TRANSLATION_MAX_RETRIES=2
FORCE_TRANSLATION_RETRY_BACKOFF_MS=500
FORCE_TRANSLATION_TEMPERATURE=0
